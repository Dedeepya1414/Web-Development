<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Academic Dashboard</title>
  <link rel="stylesheet", href="sample.css">
</head>
<body>
  <div class="layout">
    <aside>
      <h2>Campus Portal</h2>
      <a class="active" href="#">Dashboard</a>
      <a href="#">My Profile</a>
      <a href="#">Results</a>
      <a href="#">Attendance</a>
      <a href="#">Examinations</a>
      <a href="#">Announcements</a>
    </aside>

    <main>
      <header>
        <h1>Student Dashboard</h1>
        <span>Welcome, Alex Morgan</span>
      </header>

      <section class="cards">
        <article class="card">
          <div class="value">STU-2024-018</div>
          <p>Student ID</p>
        </article>
        <article class="card">
          <div class="value">Computer Science</div>
          <p>Program · Semester 4</p>
        </article>
        <article class="card">
          <div class="value">3.72</div>
          <p>Current GPA</p>
        </article>
        <article class="card">
          <div class="value">89%</div>
          <p>Overall Attendance</p>
        </article>
      </section>

      <div class="columns">
        <div>
          <section class="panel">
            <h2>Semester Results</h2>
            <table>
              <thead>
                <tr><th>Subject</th><th>Grade</th><th>Credits</th></tr>
              </thead>
              <tbody>
                <tr><td>Data Structures</td><td>A</td><td>4</td></tr>
                <tr><td>Database Systems</td><td>A-</td><td>3</td></tr>
                <tr><td>Operating Systems</td><td>B+</td><td>4</td></tr>
              </tbody>
            </table>
          </section>

          <section class="panel">
            <h2>Subject Attendance</h2>
            <p>Data Structures — 92%</p>
            <progress value="92" max="100"></progress>
            <p>Database Systems — 85%</p>
            <progress value="85" max="100"></progress>
            <p>Operating Systems — 78%</p>
            <progress value="78" max="100"></progress>
          </section>
        </div>

        <div>
          <section class="panel">
            <h2>Examination Schedule</h2>
            <table>
              <thead>
                <tr><th>Subject</th><th>Date</th><th>Time</th></tr>
              </thead>
              <tbody>
                <tr><td>Data Structures</td><td>Nov 12</td><td>9:00 AM</td></tr>
                <tr><td>Database Systems</td><td>Nov 15</td><td>1:00 PM</td></tr>
                <tr><td>Operating Systems</td><td>Nov 19</td><td>9:00 AM</td></tr>
              </tbody>
            </table>
          </section>

          <section class="panel">
            <h2>Announcements</h2>
            <div class="notice">Library hours extended during exam week.</div>
            <div class="notice">Course registration opens on November 20.</div>
            <div class="notice">Check the student portal for updated exam venues.</div>
          </section>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
* { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      color: #263247;
      background: #f4f6fb;
    }

    .layout {
      display: flex;
      min-height: 100vh;
    }

    aside {
      width: 220px;
      padding: 24px 16px;
      color: white;
      background: #243b67;
    }

    aside h2 { margin: 0 0 28px; }

    aside a {
      display: block;
      padding: 12px;
      margin: 6px 0;
      border-radius: 6px;
      color: white;
      text-decoration: none;
    }

    aside a:hover, aside a.active { background: #36558d; }

    main {
      flex: 1;
      padding: 28px;
      overflow-x: auto;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    h1 { margin: 0; font-size: 26px; }
    h2 { margin-top: 0; font-size: 18px; }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
      margin-bottom: 22px;
    }

    .card, .panel {
      padding: 20px;
      border-radius: 10px;
      background: white;
      box-shadow: 0 2px 10px #1b2b4610;
    }

    .card p { margin: 8px 0 0; color: #667085; }
    .value { font-size: 25px; font-weight: bold; }

    .columns {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 18px;
    }

    .panel { margin-bottom: 18px; }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th, td {
      padding: 12px 8px;
      border-bottom: 1px solid #e8ebf1;
    }

    th { color: #667085; font-size: 13px; }

    progress {
      width: 100%;
      height: 12px;
      accent-color: #4776d0;
    }
    .notice {
      padding: 12px;
      margin: 10px 0;
      border-left: 4px solid #4776d0;
      background: #f3f6fc;
    }

    @media (max-width: 800px) {
      .layout { display: block; }
      aside { width: 100%; }
      aside a { display: inline-block; }
      main { padding: 18px; }
      .columns { grid-template-columns: 1fr; }
      header { align-items: flex-start; gap: 10px; flex-direction: column; }
    }
